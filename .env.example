# ==============================================================================
# YamadaCompanion Environment Variables Configuration
# ==============================================================================

# Discord Configuration
# Token de tu bot en Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_PREFIX=!

# Administradores del Bot (IDs de usuario de Discord separados por coma)
ADMIN_USER_IDS=123456789,987654321

# Google Gemini API Configuration (https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here

# Lavalink Configuration (Music Server)
# Usa 'lavalink' si ejecutas con Docker Compose, o 'localhost' si ejecutas en local.
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# Bot Runtime Configuration
ENVIRONMENT=production
DEBUG=False
DB_PATH=/shared/yamada.db
